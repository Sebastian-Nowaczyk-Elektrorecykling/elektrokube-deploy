{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["repository"],
  "properties": {
    "repository": {
      "type": "object", "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"},
        "credentialsSecret": {"type": "string"},
        "pollInterval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
        "branchLimit": {"type": "integer", "minimum": 1, "maximum": 10000},
        "includeBranch": {"type": "string", "minLength": 1},
        "excludeBranch": {"type": "string"}
      }
    },
    "registry": {
      "type": "object",
      "properties": {
        "image": {"type": "string", "pattern": "^$|^ghcr\\.io/[a-z0-9][a-z0-9._/-]+$"},
        "pushSecret": {"type": "string", "minLength": 1},
        "pullSecret": {"type": "string"}
      }
    },
    "build": {
      "type": "object",
      "properties": {
        "context": {"type": "string", "minLength": 1},
        "dockerfile": {"type": "string", "minLength": 1},
        "toolsImage": {"type": "string", "minLength": 1},
        "buildkitImage": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "pattern": "^linux/(amd64|arm64)$"},
        "checkIntervalSeconds": {"type": "integer", "minimum": 2, "maximum": 300},
        "timeoutSeconds": {"type": "integer", "minimum": 300, "maximum": 86400},
        "lockWaitSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "args": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "application": {
      "type": "object",
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 100},
        "env": {"type": "array", "items": {"type": "object"}},
        "envFrom": {"type": "array"},
        "command": {"type": "array", "items": {"type": "string"}},
        "args": {"type": "array", "items": {"type": "string"}}
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "domain": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "repositoryLabel": {"type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "gateway": {
          "type": "object",
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
            "namespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
            "sectionName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
          }
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "instances": {"type": "integer", "minimum": 1, "maximum": 9},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
        "storageClass": {"type": "string", "minLength": 1},
        "name": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
        "owner": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
        "retainOnDelete": {"type": "boolean"}
      }
    }
  }
}
